@{
    // The editor side is the Courses and Projects controllers. Everything else is the viewer side.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var inEditor = controller == "Courses" || controller == "Projects";
    var owner = "My Portfolio";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | @owner</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(inEditor ? "mode-editor" : "mode-viewer")">
    <header class="bar">
        <div class="container bar-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">@owner<span>.</span></a>

            @if (!inEditor)
            {
                <form asp-controller="Home" asp-action="Index" method="get" class="bar-search">
                    <input name="q" class="form-control form-control-sm" placeholder="Search projects" aria-label="Search projects" />
                </form>
            }

            <nav class="bar-nav">
                @if (inEditor)
                {
                    <span class="mode-badge">Editing</span>
                    <a asp-controller="Courses" asp-action="Index">Courses</a>
                    <a asp-controller="Projects" asp-action="Index">Projects</a>
                    <a asp-controller="Home" asp-action="Index" class="switch">View site</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="linkbutton">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Courses" asp-action="Index" class="switch">Editor</a>
                }
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main" class="page">
            @RenderBody()
        </main>
    </div>
    <div class="arcade-lane" aria-hidden="true">
        <div class="dots"></div>
        <div class="eaten"></div>
        <div class="bug b3"></div>
        <div class="bug b2"></div>
        <div class="bug b1"></div>
        <div class="chomper"></div>
    </div>

    <div class="stage" id="stage">
        <div class="score" id="score">SCORE 0000</div>
        <div class="crate">?</div>
        <div class="coin"></div>
        <button type="button" class="hero" id="hero" title="Click me" aria-label="Make the robot jump"><span class="sprite"></span></button>
    </div>

    <script>
            (function() {
                var stage = document.getElementById('stage');
                var hero = document.getElementById('hero');
                var scoreBox = document.getElementById('score');
                var score = 0;

                hero.addEventListener('click', function() {
                    stage.classList.remove('go');
                    void stage.offsetWidth;              // restart the animation on every click
                    stage.classList.add('go');

                    setTimeout(function() {             // the robot reaches the crate a moment later
                        score += 100;
                        scoreBox.textContent = 'SCORE ' + String(score).padStart(4, '0');
                    }, 280);
                });
            })();
    </script>
    <footer class="foot">
        <div class="container">&copy; 2026 @owner. Built with ASP.NET Core MVC and PostgreSQL on Supabase.</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/portfolio.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
