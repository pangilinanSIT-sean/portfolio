@model HomePage
@{
    ViewData["Title"] = "Home";
}

<section class="intro">
    <p class="kicker">Portfolio</p>
    <h1>The courses I've taken, and what I built in them.</h1>
    <p class="intro-lead">@Model.Courses.Count courses and @Model.Courses.Sum(c => c.ProjectCount) projects, with the screens, videos and code behind each one.</p>
    <form asp-controller="Home" asp-action="Index" method="get" class="intro-search">
        <input name="q" value="@Model.Query" class="form-control" placeholder="Search projects, tools or course codes" aria-label="Search" />
        <button class="btn btn-accent" type="submit">Search</button>
    </form>
</section>

@if (Model.Query != "")
{
    <p class="hint">@Model.Projects.Count @(Model.Projects.Count == 1 ? "project matches" : "projects match") "@Model.Query". <a asp-controller="Home" asp-action="Index">Show everything</a></p>
}

@foreach (var course in Model.Courses)
{
    var projects = Model.Projects.Where(p => p.CourseId == course.CourseId).ToList();
    if (Model.Query != "" && projects.Count == 0)
    {
        continue;
    }

    <section class="course-block" style="--h:@course.Hue">
        <div class="course-block-head">
            <span class="codebadge">@course.Code</span>
            <h2>@course.Title</h2>
        </div>
        @if (Model.Query == "" && !string.IsNullOrEmpty(course.Description))
        {
            <p class="hint">@course.Description</p>
        }

        @if (projects.Count == 0)
        {
            <p class="hint">No projects in this course yet.</p>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in projects)
                {
                    <partial name="_ProjectCard" model="project" />
                }
            </div>
        }
    </section>
}
