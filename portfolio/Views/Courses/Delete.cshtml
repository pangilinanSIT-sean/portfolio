@model Course
@{
    ViewData["Title"] = "Delete a course";
}

<div class="head-row">
    <div>
        <h1 class="page-title">Delete a course</h1>
        <p class="hint">This cannot be undone.</p>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="notice">@ViewBag.Error</div>
}

<div class="panel panel-danger">
    <p>Are you sure you want to delete this course?</p>
    <dl class="facts">
        <dt>Code</dt>
        <dd>@Model.Code</dd>
        <dt>Title</dt>
        <dd>@Model.Title</dd>
        <dt>Term</dt>
        <dd>@(Model.Term ?? "—")</dd>
    </dl>
    <p class="hint">A course that still has projects cannot be deleted.</p>

    <form asp-action="Delete" asp-route-id="@Model.CourseId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-quiet">Cancel</a>
    </form>
</div>
